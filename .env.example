# Copy to .env for local development. Never commit the real .env.

# Long random string used to sign session cookies. Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Port the server listens on (most hosts set this for you).
PORT=3000

# Set to "production" when deployed.
NODE_ENV=development

# Where the SQLite file lives. On a host with a mounted disk, point this at it,
# e.g. /var/data/oba.db
DATABASE_FILE=./data/oba.db

# This account is made an administrator each time the server starts. Useful if
# you ever lose admin access.
ADMIN_EMAIL=
