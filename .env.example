# Copy to .env for local development. Never commit the real .env.

# Postgres connection string. Get a free one from https://neon.tech —
# create a project, then copy the "Pooled connection" string.
# It looks like:
#   postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Long random string used to sign session cookies. Required in production.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Port the server listens on (most hosts set this for you).
PORT=3000

# Set to "production" when deployed.
NODE_ENV=development

# This account is made an administrator each time the server starts. Useful if
# you ever lose admin access.
ADMIN_EMAIL=
