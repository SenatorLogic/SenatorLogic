<%- include('partials/header') %>

<div class="section-head">
  <div>
    <p class="eyebrow">Directory</p>
    <h1>Members</h1>
  </div>
  <p><%= members.length %> <%= members.length === 1 ? 'member' : 'members' %> found</p>
</div>

<form class="searchbar" method="get" action="/members">
  <input type="text" name="q" value="<%= query %>" placeholder="Search name, job, community…" aria-label="Search members">
  <select name="office" aria-label="Filter by office">
    <option value="">Everyone</option>
    <option value="executives" <%= office === 'executives' ? 'selected' : '' %>>Executives only</option>
    <% offices.forEach((o) => { %>
      <option value="<%= o.name %>" <%= office === o.name ? 'selected' : '' %>><%= o.name %></option>
    <% }) %>
  </select>
  <button class="btn" type="submit">Search</button>
  <% if (query || office) { %><a class="btn ghost" href="/members">Clear</a><% } %>
</form>

<% if (members.length) { %>
  <div class="grid members">
    <% members.forEach((person) => { %>
      <%- include('partials/person-card', { person }) %>
    <% }) %>
  </div>
<% } else { %>
  <div class="card empty">
    <p>No members matched that search.</p>
    <a class="btn ghost" href="/members">Show everyone</a>
  </div>
<% } %>

<%- include('partials/footer') %>
